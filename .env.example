# Contact form (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional: GitHub token for the home page's top languages (GraphQL API).
# Fine-grained token: all repositories, Metadata read-only.
GITHUB_TOKEN=

# Optional: this machine's LAN address(es), comma-separated, so other
# devices on the same network can load `pnpm dev`. Dev only.
DEV_ORIGINS=

# Optional: canonical site URL. Falls back to Vercel's production URL.
NEXT_PUBLIC_SITE_URL=
